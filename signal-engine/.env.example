SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key
APIFY_API_TOKEN=your-apify-api-token
SCRAPER_DELAY_MS=1500
SCRAPER_MAX_RETRIES=3
PORT=8001

# ---- Enrichment APIs ----
# Serper (Google Search) — used to find/verify company websites and to find
# decision-maker LinkedIn profiles for contact enrichment
# Get a free key at https://serper.dev (2,500 free queries/mo)
SERPER_API_KEY=your-serper-api-key

# MillionVerifier (optional) — verifies pattern-generated contact emails
# (first.last@domain etc.). Without it, only emails found on the company's
# own website are returned. https://millionverifier.com
MILLIONVERIFIER_API_KEY=
